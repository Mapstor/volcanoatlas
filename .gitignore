/AGENTS.md

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw downloads from scripts/fetch-sources.py (the slimmed files in data/sources/ are committed)
/data/sources-raw/
